{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "project-think/category-filter",
  "title": "Project Category Filter",
  "category": "widgets",
  "icon": "filter",
  "description": "Display a filterable list of categories/subjects for projects",
  "supports": {
    "html": false,
    "align": true
  },
  "attributes": {
    "showAllOption": {
      "type": "boolean",
      "default": true
    },
    "displayStyle": {
      "type": "string",
      "default": "buttons",
      "enum": ["buttons", "dropdown", "list"]
    },
    "taxonomy": {
      "type": "string",
      "default": "category"
    }
  },
  "textdomain": "project-think",
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
